  <div class="page">
    <header class="masthead">
      <div class="monogram" aria-label="Luis y Carlota">L <span>♡</span> C</div>
      <div class="masthead-note">Un pedacito de mi corazón, para ti</div>
    </header>
    <main>
      <section class="hero" aria-labelledby="carlota-title">
        <div class="hero-copy">
          <div class="eyebrow">Para alguien muy especial</div>
          <h1 id="carlota-title">Carlota<span class="period">.</span></h1>
          <span class="script">Te extraño, amor.</span>
          <p class="hero-intro">Hay personas que, aun estando lejos, siguen cerquita del corazón. Tú eres esa persona para mí.</p>
          <div class="hero-actions">
            <button class="btn" type="button" id="heroLetter"><span class="tiny">♡</span> Lee mi carta</button>
            <button class="btn btn-outline" type="button" id="heroMusic"><span class="tiny">♫</span> Nuestra canción</button>
          </div>
          <div class="signoff">Con cariño, Luis Erazo</div>
        </div>
        <div class="photo-area">
          <span class="doodle" aria-hidden="true">✧</span><span class="doodle2" aria-hidden="true">✦</span>
          <div class="photo-frame">
            <div class="photo-inner">
              <img id="portraitImage" class="portrait" alt="Fotografía especial de Carlota" src="data:image/jpeg;base64," style="display: block;">
              <div id="photoEmpty" class="photo-placeholder" style="display: none;">
                <div class="placeholder-icon"><svg viewBox="0 0 80 80" width="57" height="57" fill="none" aria-hidden="true"><path d="M16 56V29a5 5 0 015-5h9l5-7h10l5 7h9a5 5 0 015 5v27a5 5 0 01-5 5H21a5 5 0 01-5-5Z" stroke="currentColor" stroke-width="2"></path><circle cx="40" cy="43" r="12" stroke="currentColor" stroke-width="2"></circle><path d="M36 41c-1-3-6-2-6 2 0 5 10 10 10 10s10-5 10-10c0-4-5-5-7-2l-3 3-4-3Z" fill="currentColor" opacity=".65"></path></svg></div>
                <div class="placeholder-text">Tu foto aquí,<br>Carlota</div>
                <div class="placeholder-sub">Una imagen para guardar este cariño.</div>
              </div>
            </div>
          </div>
          <div class="photo-caption">Mi pensamiento favorito</div>
          <svg class="floral floral-one" viewBox="0 0 280 265" role="img" aria-label="Rosas rojas y amarillas"><use href="#red-rose" x="14" y="31" width="158" height="202" transform="rotate(-19 84 130)"></use><use href="#yellow-rose" x="110" y="58" width="150" height="190" transform="rotate(22 185 150)"></use><use href="#red-rose" x="70" y="-3" width="144" height="183"></use></svg>
