  <button type="button" class="editor-tab" id="editorOpen">✎ &nbsp; Personalizar página</button>
  <div class="editor-backdrop" id="editorBackdrop"></div>
  <aside class="editor" id="editorPanel" aria-label="Personalizar esta página" aria-hidden="true">
    <div class="editor-top"><h2 class="editor-title">Hazla única ♡</h2><button class="editor-close" type="button" id="editorClose" aria-label="Cerrar personalización">×</button></div>
    <p class="editor-subtitle">Agrega la fotografía de Carlota y tu canción MP3. Al terminar, descarga la página lista para publicarla, con ambos archivos integrados.</p>
    <label class="upload-zone" for="photoInput"><span class="upload-title">① Fotografía de Carlota</span><span class="upload-detail" id="photoLabel">✓ Foto colocada: 1000695729.jpg</span><input id="photoInput" type="file" accept="image/*"></label>
    <label class="upload-zone" for="musicInput"><span class="upload-title">② La canción que le dedicarás</span><span class="upload-detail" id="musicLabel">✓ Canción colocada: José José - El Amar y el Querer (Letra Lyrics) (1).mp3</span><input id="musicInput" type="file" accept="audio/mpeg,audio/mp3,.mp3"></label>
    <div class="editor-tip"><strong>Importante:</strong> la música no comienza automáticamente; Carlota podrá iniciarla con el botón de reproducción. Por las reglas de los navegadores, esto garantiza una mejor experiencia.</div>
    <button type="button" class="download-btn" id="downloadFinal">↓ &nbsp; Descargar página lista (index.html)</button>
    <p class="editor-fine">El archivo descargado conserva la foto y la canción dentro del HTML y oculta estas opciones de edición. Puedes subirlo directamente a tu alojamiento web. Conserva este archivo original por si después deseas cambiar algo.</p>
    <p class="editor-status" id="editorStatus" aria-live="polite"></p>
  </aside>
  <div class="toast" id="toast" aria-live="polite"></div>
  <script>
    (function(){
      'use strict';
      const $ = (id) => document.getElementById(id);
      const editor = $('editorPanel'), backdrop = $('editorBackdrop');
      const audio = $('musicAudio'), musicBtn = $('musicToggle'), musicCard = $('musicCard');
      const image = $('portraitImage'), placeholder = $('photoEmpty');
      let toastTimer;
      function notify(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),4200)}
      function openEditor(){editor.classList.add('open');backdrop.classList.add('open');editor.setAttribute('aria-hidden','false')}
      function closeEditor(){editor.classList.remove('open');backdrop.classList.remove('open');editor.setAttribute('aria-hidden','true')}
      $('editorOpen').addEventListener('click',openEditor);
      $('editorClose').addEventListener('click',closeEditor);
      backdrop.addEventListener('click',closeEditor);
      document.addEventListener('keydown',e=>{if(e.key==='Escape')closeEditor()});
      function readDataURL(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=()=>reject(new Error('No se pudo leer el archivo'));r.readAsDataURL(file)})}
      function optimizePhoto(file){return new Promise(async(resolve,reject)=>{try{const url=await readDataURL(file);const img=new Image();img.onload=()=>{const maxW=1100,maxH=1400,scale=Math.min(1,maxW/img.width,maxH/img.height);const c=document.createElement('canvas');c.width=Math.max(1,Math.round(img.width*scale));c.height=Math.max(1,Math.round(img.height*scale));const ctx=c.getContext('2d');ctx.drawImage(img,0,0,c.width,c.height);resolve(c.toDataURL('image/jpeg',.84))};img.onerror=()=>reject(new Error('Formato de foto no compatible'));img.src=url}catch(err){reject(err)}})}
      $('photoInput').addEventListener('change',async e=>{const file=e.target.files&&e.target.files[0];if(!file)return;try{$('editorStatus').textContent='Preparando fotografía…';const data=await optimizePhoto(file);image.setAttribute('src',data);image.style.display='block';placeholder.style.display='none';$('photoLabel').textContent='✓ Foto colocada: '+file.name;$('editorStatus').textContent='Fotografía colocada correctamente.';notify('La fotografía de Carlota ya está puesta ♡')}catch(err){$('editorStatus').textContent='No se pudo cargar la foto: '+err.message}});
      $('musicInput').addEventListener('change',async e=>{const file=e.target.files&&e.target.files[0];if(!file)return;if(!/\.mp3$/i.test(file.name) && file.type!=='audio/mpeg'){$('editorStatus').textContent='Selecciona un archivo de audio MP3.';return}try{$('editorStatus').textContent='Preparando canción…';const data=await readDataURL(file);audio.pause();audio.setAttribute('src',data);audio.load();musicBtn.disabled=false;$('musicLabel').textContent='✓ Canción colocada: '+file.name;$('musicStatus').textContent='Una canción escogida especialmente para Carlota ♡';$('musicButtonText').textContent='Reproducir canción';musicCard.classList.remove('is-playing');$('editorStatus').textContent='Canción MP3 lista para escuchar.';notify('La canción ya está lista ♫')}catch(err){$('editorStatus').textContent='No se pudo cargar la canción: '+err.message}});
      musicBtn.addEventListener('click',async()=>{if(!audio.getAttribute('src')){notify('Primero agrega la canción MP3 en Personalizar página.');return}if(audio.paused){try{await audio.play()}catch(err){notify('No se pudo reproducir el archivo. Prueba otro MP3.')}}else{audio.pause()}});
      audio.addEventListener('play',()=>{musicCard.classList.add('is-playing');$('musicButtonText').textContent='Pausar canción';$('musicStatus').textContent='♪ Sonando para ti, Carlota…'});
      audio.addEventListener('pause',()=>{musicCard.classList.remove('is-playing');$('musicButtonText').textContent='Reproducir canción';if(audio.getAttribute('src'))$('musicStatus').textContent='Una canción escogida especialmente para Carlota ♡'});
      audio.addEventListener('ended',()=>{musicCard.classList.remove('is-playing')});
      audio.addEventListener('error',()=>{if(audio.getAttribute('src'))$('musicStatus').textContent='Este navegador no pudo reproducir la canción. Prueba otro MP3.'});
      function toggleLetter(open){const l=$('letterContent'),b=$('letterToggle');const next=typeof open==='boolean'?open:!l.classList.contains('is-open');l.classList.toggle('is-open',next);b.setAttribute('aria-expanded',String(next));b.innerHTML=next?'Cerrar mi carta &nbsp;♡':'Abrir mi carta &nbsp;♡'}
      $('letterToggle').addEventListener('click',()=>toggleLetter());
      $('heroLetter').addEventListener('click',()=>{toggleLetter(true);$('letterCard').scrollIntoView({behavior:'smooth',block:'center'})});
      $('heroMusic').addEventListener('click',()=>{$('musicCard').scrollIntoView({behavior:'smooth',block:'center'});if(audio.getAttribute('src'))musicBtn.focus({preventScroll:true});else if(!document.body.classList.contains('published'))notify('Puedes añadir tu MP3 desde “Personalizar página”.')});
      $('downloadFinal').addEventListener('click',()=>{
        if(!image.getAttribute('src')||!audio.getAttribute('src')){notify('Puedes guardar la página, pero te falta '+(!image.getAttribute('src')&&!audio.getAttribute('src')?'la foto y la canción':(!image.getAttribute('src')?'la foto':'la canción'))+'.')}
        try{
          const clone=document.documentElement.cloneNode(true);
          clone.querySelector('body').classList.add('published');
          clone.querySelector('#editorPanel').classList.remove('open');
          clone.querySelector('#editorBackdrop').classList.remove('open');
          clone.querySelector('#editorPanel').setAttribute('aria-hidden','true');
          clone.querySelector('#toast').classList.remove('show');
          clone.querySelector('#toast').textContent='';
          clone.querySelector('#editorStatus').textContent='';
          const script=clone.querySelector('script');
          // The script is kept so the letter and music remain interactive in the exported page.
          const html='<!DOCTYPE html>\n'+clone.outerHTML;
          const blob=new Blob([html],{type:'text/html;charset=utf-8'});
          const url=URL.createObjectURL(blob);
          const a=document.createElement('a');a.href=url;a.download='index.html';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),10000);
          $('editorStatus').textContent='La página lista se ha descargado como index.html.';
        }catch(err){$('editorStatus').textContent='No se pudo descargar: '+err.message}
      });
      // When opening the exported HTML, detect the embedded media.
      if(image.getAttribute('src')){image.style.display='block';placeholder.style.display='none'}
      if(audio.getAttribute('src')){musicBtn.disabled=false;$('musicStatus').textContent='Una canción escogida especialmente para Carlota ♡'}
    })();
  </script>


