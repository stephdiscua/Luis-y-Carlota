  <footer class="ending">
    <svg class="footer-flowers" viewBox="0 0 270 190" aria-label="Una rosa roja y una rosa amarilla" role="img"><use href="#red-rose" x="25" y="0" width="145" height="182" transform="rotate(-13 90 90)"></use><use href="#yellow-rose" x="104" y="0" width="140" height="175" transform="rotate(18 174 88)"></use></svg>
    <div class="ending-big">Te extraño, amor.</div>
